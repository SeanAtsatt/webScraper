{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "WebSearch",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:docs.github.com)"
    ],
    "ask": [
      "mcp__jcodemunch__index_repo"
    ]
  },
  "env": {
    "CLAUDE_PROJECT_ROOT": "."
  }
}
